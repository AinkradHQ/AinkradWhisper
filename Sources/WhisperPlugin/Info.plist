    <key>AinkradAppID</key><string>whisper</string>
    <key>AinkradDisplayName</key><string>Whisper</string>
    <key>AinkradIconSymbol</key><string>bubble.left.and.bubble.right</string>
    <key>AinkradAPIVersion</key><integer>11</integer>
    <key>AinkradAuthor</key><string>Ahmed Elhalaby</string>
    <key>description</key><string>Slack, Teams and WhatsApp in one place.</string>
</dict>
</plist>
